# ---------- Payments ----------
# Stripe (card, Apple Pay, Google Pay). Dashboard > Developers > API keys.
STRIPE_SECRET_KEY=
# Stripe webhook signing secret (endpoint: https://YOUR-DOMAIN/api/webhooks/stripe,
# events: checkout.session.completed, checkout.session.async_payment_succeeded)
STRIPE_WEBHOOK_SECRET=

# PayPal REST app (developer.paypal.com > Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" for testing, "live" for real payments
PAYPAL_ENV=sandbox

# ---------- Shipping ----------
# Flat shipping charge per order in USD (0 = included in price)
SHIPPING_FLAT_USD=0
# Comma-separated ISO country codes you ship to
SHIPPING_COUNTRIES=US

# Public site URL used for payment return links (optional; auto-detected)
NEXT_PUBLIC_SITE_URL=

# ---------- Email (contact form + order notifications) via Resend ----------
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
# Where new-order emails go (defaults to CONTACT_TO_EMAIL)
ORDER_NOTIFY_EMAIL=
